{
    "manifest_version": 3,
    "name": "DownloadLib",
    "version": "1.1.0",
    "description": "Скачивает мангу с порталов MangaLib в удобном для чтения формате.",
    "author": "https://ivanvit.ru",
    "homepage_url": "https://github.com/ivanvit100/DownloadLib",

    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "downloads",
        "storage",
        "webRequest",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],

    "host_permissions": [
        "https://*/*"
    ],

    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
        "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'unsafe-inline'; child-src 'self';"
    },

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "sandbox": {
        "pages": ["sandbox.html"]
    },

    "web_accessible_resources": [{
        "resources": ["lib/kf8.wasm"],
        "matches": ["<all_urls>"]
    }]
}
